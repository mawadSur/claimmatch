# Copy to .env.local (gitignored), or set these as EAS environment variables.
# EXPO_PUBLIC_ values are compiled into the app bundle: never put a secret here.

# Same values as the web app's NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Defaults to https://lawsuitai.org. Use the apex domain: the www host
# redirects, and a redirect can drop the Authorization header.
EXPO_PUBLIC_API_BASE_URL=
