# ─────────────────────────────────────────────────────────────────────────────
# ClaimMatch environment variables. Copy to `.env.local` and fill in.
# The app runs with graceful fallbacks if these are missing, but auth,
# persistence, matching, and email require real values.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server jobs only (scrape/match cron). NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for metadata + email links)
NEXT_PUBLIC_SITE_URL=https://claimmatch.vercel.app

# Resend (transactional email) — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM="ClaimMatch <matches@claimmatch.app>"

# Secret that protects the cron endpoints (/api/cron/*). Vercel Cron sends this
# automatically as an Authorization header. Generate with: openssl rand -hex 32
CRON_SECRET=change-me-to-a-long-random-string

# Anthropic (Claude) — powers the LLM extraction pipeline that turns scraped
# settlement text into structured, machine-readable lawsuit records.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Comma-separated emails that get admin access (bootstraps the first admin
# without editing the DB). Also set profiles.is_admin = true for durable admins.
ADMIN_EMAILS=you@example.com

# Contingency fee we take from a recovery (the "we take a %" model). 0.15 = 15%.
# Public because the UI displays it; keep it in sync with any signed agreement.
NEXT_PUBLIC_CLAIMMATCH_FEE_PCT=0.15

# Optional SMS (Twilio) — match alerts by text. Left unset, SMS is a no-op stub.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# PostHog product analytics — https://posthog.com
# Get these from PostHog Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
