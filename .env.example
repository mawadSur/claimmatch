# ─────────────────────────────────────────────────────────────────────────────
# ClaimMatch environment variables. Copy to `.env.local` and fill in.
# The app builds and runs without them, but sign-in, claim tracking, the
# catalog and email need real values.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: server code only. NEVER expose it to the browser. Required
# for every claim write, unsubscribe and the cron jobs (they fail loudly without it).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for metadata + email links)
NEXT_PUBLIC_SITE_URL=https://lawsuitai.org

# Resend (transactional email) — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM="ClaimMatch <matches@claimmatch.app>"

# Secret that protects the cron endpoints (/api/cron/*) and /api/health/schema.
# Vercel Cron sends this automatically as an Authorization header.
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me-to-a-long-random-string

# Optional: POST {job, error, at} here when the daily ingest or digest fails.
# Unset is a no-op. Never commit a real webhook URL.
ALERT_WEBHOOK_URL=

# Anthropic (Claude). Not used in Phase 0: the nightly ingest makes no model
# calls. Kept for later drafting tools.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Comma-separated emails that get admin access (bootstraps the first admin
# without editing the DB). Also set profiles.is_admin = true for durable admins.
ADMIN_EMAILS=you@example.com

# Legal contact details shown on Privacy, Terms, Trust, Settings and the footer.
# Leave unset until each is real: unset, blank or placeholder values render
# nothing. NEXT_PUBLIC_ values are fixed at build time, so redeploy after
# changing them. Use a literal \n for line breaks in the postal address.
# NEXT_PUBLIC_CONTACT_EMAIL is required for Production: a production build
# (VERCEL_ENV=production) stops without an inbox that receives mail.
# TODO (B2): a ClaimMatch inbox — do not put a Sur Consulting address here.
NEXT_PUBLIC_CONTACT_EMAIL=
# TODO (B2/B5): legal entity name once chosen
NEXT_PUBLIC_LEGAL_ENTITY=
# TODO (B2/B5): CAN-SPAM postal address once the entity exists
NEXT_PUBLIC_POSTAL_ADDRESS=

# Switches (src/lib/flags.ts). Each is on only when set to exactly "1".
# D50: keep the match email and the Monday digest off until Phase 1 ships.
MATCH_EMAILS_ENABLED=
DIGEST_ENABLED=
# Richer profile (facts, /settings/profile, /admin/users) and stored matches.
# Each is on only when set to exactly "1". Leave unset in production.
PROFILE_V2_ENABLED=
MATCH_STORE_ENABLED=
# Admin money actions on legacy recovery rows (/admin/recoveries).
ADMIN_RECOVERIES_ENABLED=
# The made-up sample adapter, for local development only (never in production).
ENABLE_SAMPLE_SOURCE=
# C7–C15 / C17 user-value features. Each is on only when set to exactly "1".
# Leave unset until B9 (what "verified" means) and a review of the public surfaces.
VERIFIED_FIELDS_ENABLED=
CALENDAR_ICS_ENABLED=
CLOSES_IN_CHIPS_ENABLED=
SETTLEMENT_OG_ENABLED=
NOTICE_LOOKUP_ENABLED=
FORM_FIELD_ORDER_ENABLED=
PROOF_FEEDBACK_ENABLED=
CLOSED_ARCHIVE_ENABLED=
# C15: never send unless this is exactly "1" and a postal address + verified
# RESEND_FROM (not onboarding@resend.dev) exist.
CLOSING_SOON_EMAIL_ENABLED=
HOME_NARROWING_ENABLED=
# C16: E3/E4/E7 stay off. Flags do not ship the features — counsel (B4) and
# partner calls still block a qualify verdict, official-form autofill, and
# any partner widget. C10 FORM_FIELD_ORDER_ENABLED is packet order, not E4.
ELIGIBILITY_QUESTIONS_ENABLED=
FORM_AUTOFILL_ENABLED=
PARTNER_WIDGET_ENABLED=
# Matching quality. Off keeps today's scores (no-rule rows 0.35; state-only 1.0).
# Deadline filtering is always on and is not behind a flag.
MATCH_UNSTRUCTURED_ENABLED=
MATCH_STATE_ONLY_CAP_ENABLED=
# Stage 2/3 filing, match-training logs, eligibility drafts, ingest email.
# Each is on only when set to exactly "1". Leave unset in production.
ASSISTED_FILING_ENABLED=
DIRECT_FILING_ENABLED=
MATCH_METRICS_ENABLED=
ELIGIBILITY_DRAFTS_ENABLED=
INGEST_ALERT_EMAILS_ENABLED=
LINK_CHECK_ENABLED=
PAYOUT_REPORT_ENABLED=
# Public recovery-share fee on every ClaimMatch claim. Off keeps “free during beta”.
FEE_DISCLOSURE_ENABLED=
INGEST_MISSING_CLOSE_QUEUE_ENABLED=
LAWSUITS_PAGINATION_ENABLED=
# Comma-separated tester emails. Tagged internal and excluded from traction.
INTERNAL_EMAILS=
# Optional. Defaults to the Playwright stub. Tests use mock.
FILING_WORKER=

# Nightly ingest circuit breaker: the share (0 to 1) of a source's open
# settlements one run may close; above it, closures are held and logged.
# Default 0.2. Set to 1 for one run to apply a reviewed closure list.
INGEST_MAX_CLOSE_SHARE=
# Successful non-empty feeds a feed-source row may miss before it is closed.
# Default 3. Integer 1–30. A failed or empty feed never counts.
INGEST_MISSING_FEED_CLOSE_AFTER=
# Plan the nightly ingest and report which rows would close; write nothing.
# Set to 1 on a local/staging scrape: CLAIMMATCH_ENV=local npm run scrape:dry-run
INGEST_DRY_RUN=
# Admin queue to approve or dismiss held ingest closures. Off: hidden.
ADMIN_HELD_CLOSURES_ENABLED=
# Group the held-closure queue by a suggested decision. Official-site checks
# run from cron only. Off: the flat queue stays as it is.
HELD_CLOSURE_TRIAGE_ENABLED=
# Ingest may close a held row whose stored deadline is already past. Off: those
# rows stay in the review queue.
HELD_AUTO_CLOSE_PAST_DEADLINE=
# Email opted-in users 7 days and 1 day before a tracked, unfiled claim deadline.
DEADLINE_REMINDERS_ENABLED=
# Incomplete-onboarding and "did you file?" drips. Off unless exactly "1".
# Still refuses without a postal address and a verified RESEND_FROM.
ONBOARDING_DRIP_ENABLED=
# Dashboard "answer N more questions" card. Off unless exactly "1".
PROFILE_COMPLETENESS_ENABLED=
# Public /invite landing. Off: that path 404s.
SOFT_INVITE_LANDING_ENABLED=
# Held-only ingest nights return 200 and a warning jobs row. Off: those nights 500.
INGEST_HELD_IS_WARNING=
# Home "Data breach & privacy" and "No proof required" cards. Off: hidden.
# HOME_NARROWING_ENABLED is the older name for the same cards.
HOME_WEDGE_ENTRIES_ENABLED=
# Home hero primary CTA goes to /signup. Off keeps "See open settlements".
HOME_ACCOUNT_FIRST_CTA_ENABLED=
# Logged-out match preview (home + /lawsuits → /preview). Off: hidden and 404.
MATCH_PREVIEW_ENABLED=
# Signed-out claim CTAs go through /signup and return to that claim. Off: /login.
SIGNUP_CONTEXT_ENABLED=
# Settlement-page "Check if you qualify" starts a scoped match preview. Off:
# those CTAs still go to /claim/{slug}. Closed listings never show it.
SETTLEMENT_PAGE_CTA_ENABLED=
# Related open settlements on each settlement page. Off: hidden.
RELATED_SETTLEMENTS_ENABLED=
# Panel-objection copy (browse without account, what we store, hide unknown
# payout/proof, neutral beta pricing). Off: current live copy. Counsel review
# the pricing line before flipping.
PANEL_TRUST_COPY_ENABLED=
# Catalog order: no-proof, higher listed payout, sooner deadline. Off: deadline first.
CATALOG_VALUE_RANK_ENABLED=
# Signed-out per-settlement eligibility checklist from stored text only.
# Off: hidden. Never a "you qualify" verdict.
SETTLEMENT_QUIZ_ENABLED=
# Per-tester / per-community invite codes on /admin SoftLaunch. Off: hidden.
# Reuses share_links. Apply nothing extra; turn on after SOFT_INVITE_LANDING if
# you want /invite?code= landings (short /r/CODE works either way).
BETA_INVITE_CODES_ENABLED=
# Signed-in dashboard beta feedback + interview opt-in. Off: hidden.
# Needs migration 0033. Never emails.
BETA_FEEDBACK_ENABLED=
# Omit unknown proof/payout/deadline on catalog cards; stop collecting phone
# in Settings. Off: current live cards and the phone field stay. Does not
# delete stored phone values.
CATALOG_HIDE_UNKNOWNS_ENABLED=
# After nightly ingest and admin publish/close, ping IndexNow with changed
# public URLs. Off: no network calls. Needs INDEXNOW_KEY (8–128 letters or
# digits). The key file is served at /{INDEXNOW_KEY}.txt and /indexnow-key.txt.
INDEXNOW_ENABLED=
INDEXNOW_KEY=
# Public /llms.txt for AI tools (llmstxt.org). Off: 404.
LLMS_TXT_ENABLED=
# Classify ChatGPT / Perplexity / Copilot / Gemini / Google first-touch on
# PostHog events and profiles; show an admin signups-by-channel card.
# Needs migration 0034. Off: no new property, no extra RPC, no admin card.
AI_REFERRER_ATTRIBUTION_ENABLED=
# Opt-in new-match alert emails (verified open listings, 1/week, max 3 claims,
# one-click start). Off unless exactly "1". Still refuses without a postal
# address, verified RESEND_FROM, RESEND_API_KEY, and MATCH_ALERT_TOKEN_SECRET
# (falls back to CRON_SECRET). Never sends from CI or tests. Needs migration 0036.
MATCH_ALERT_EMAILS_ENABLED=
# HMAC secret for one-click start tokens. Falls back to CRON_SECRET if unset.
MATCH_ALERT_TOKEN_SECRET=

# `npm run seed` and `npm run scrape` refuse to run unless this is exactly
# "local" or "staging". They always refuse the production project.
CLAIMMATCH_ENV=

# SMS (Twilio). Not used: ClaimMatch sends no text messages.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# PostHog product analytics — https://posthog.com
# TODO (B6): a ClaimMatch project (not the "Sur Website" project). Analytics
# stay off when the key is unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT=
