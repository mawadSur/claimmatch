# ─────────────────────────────────────────────────────────────────────────────
# ClaimMatch environment variables. Copy to `.env.local` and fill in.
# The app builds and runs without them, but sign-in, claim tracking, the
# catalog and email need real values.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: server code only. NEVER expose it to the browser. Required
# for every claim write, unsubscribe and the cron jobs (they fail loudly without it).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for metadata + email links)
# TODO (B3): the chosen public domain once it is live
NEXT_PUBLIC_SITE_URL=https://claimmatch.vercel.app

# Resend (transactional email) — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM="ClaimMatch <matches@claimmatch.app>"

# Secret that protects the cron endpoints (/api/cron/*) and /api/health/schema.
# Vercel Cron sends this automatically as an Authorization header.
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me-to-a-long-random-string

# Optional: POST {job, error, at} here when the daily ingest or digest fails.
# Unset is a no-op. Never commit a real webhook URL.
ALERT_WEBHOOK_URL=

# Anthropic (Claude). Not used in Phase 0: the nightly ingest makes no model
# calls. Kept for later drafting tools.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Comma-separated emails that get admin access (bootstraps the first admin
# without editing the DB). Also set profiles.is_admin = true for durable admins.
ADMIN_EMAILS=you@example.com

# Legal contact details shown on Privacy, Terms, Trust, Settings and the footer.
# Leave unset until each is real: unset, blank or placeholder values render
# nothing. NEXT_PUBLIC_ values are fixed at build time, so redeploy after
# changing them. Use a literal \n for line breaks in the postal address.
# NEXT_PUBLIC_CONTACT_EMAIL is required for Production: a production build
# (VERCEL_ENV=production) stops without an inbox that receives mail.
# TODO (B2): a ClaimMatch inbox — do not put a Sur Consulting address here.
NEXT_PUBLIC_CONTACT_EMAIL=
# TODO (B2/B5): legal entity name once chosen
NEXT_PUBLIC_LEGAL_ENTITY=
# TODO (B2/B5): CAN-SPAM postal address once the entity exists
NEXT_PUBLIC_POSTAL_ADDRESS=

# Switches (src/lib/flags.ts). Each is on only when set to exactly "1".
# D50: keep the match email and the Monday digest off until Phase 1 ships.
MATCH_EMAILS_ENABLED=
DIGEST_ENABLED=
# Admin money actions on legacy recovery rows (/admin/recoveries).
ADMIN_RECOVERIES_ENABLED=
# The made-up sample adapter, for local development only (never in production).
ENABLE_SAMPLE_SOURCE=
# C7–C15 / C17 user-value features. Each is on only when set to exactly "1".
# Leave unset until B9 (what "verified" means) and a review of the public surfaces.
VERIFIED_FIELDS_ENABLED=
CALENDAR_ICS_ENABLED=
CLOSES_IN_CHIPS_ENABLED=
SETTLEMENT_OG_ENABLED=
NOTICE_LOOKUP_ENABLED=
FORM_FIELD_ORDER_ENABLED=
PROOF_FEEDBACK_ENABLED=
CLOSED_ARCHIVE_ENABLED=
# C15: never send unless this is exactly "1" and a postal address + verified
# RESEND_FROM (not onboarding@resend.dev) exist.
CLOSING_SOON_EMAIL_ENABLED=
HOME_NARROWING_ENABLED=

# Nightly ingest circuit breaker: the share (0 to 1) of a source's open
# settlements one run may close; above it, closures are held and logged.
# Default 0.2. Set to 1 for one run to apply a reviewed closure list.
INGEST_MAX_CLOSE_SHARE=
# Successful non-empty feeds a feed-source row may miss before it is closed.
# Default 3. Integer 1–30. A failed or empty feed never counts.
INGEST_MISSING_FEED_CLOSE_AFTER=
# Plan the nightly ingest and report which rows would close; write nothing.
# Set to 1 on a local/staging scrape: CLAIMMATCH_ENV=local npm run scrape:dry-run
INGEST_DRY_RUN=

# `npm run seed` and `npm run scrape` refuse to run unless this is exactly
# "local" or "staging". They always refuse the production project.
CLAIMMATCH_ENV=

# SMS (Twilio). Not used: ClaimMatch sends no text messages.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# PostHog product analytics — https://posthog.com
# TODO (B6): a ClaimMatch project (not the "Sur Website" project). Analytics
# stay off when the key is unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT=
