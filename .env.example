# ─────────────────────────────────────────────────────────────────────────────
# ClaimMatch environment variables. Copy to `.env.local` and fill in.
# The app runs with graceful fallbacks if these are missing, but auth,
# persistence, matching, and email require real values.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server jobs only (scrape/match cron). NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for metadata + email links)
NEXT_PUBLIC_SITE_URL=https://claimmatch.vercel.app

# Resend (transactional email) — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM="ClaimMatch <matches@claimmatch.app>"

# Secret that protects the cron endpoints (/api/cron/*). Set the same value as a
# Vercel Cron header or query param. Generate with: openssl rand -hex 32
CRON_SECRET=change-me-to-a-long-random-string
